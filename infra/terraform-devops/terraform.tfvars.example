# Copy to terraform.tfvars (gitignored) and fill in.
# Also export before running terraform (never put these in a file):
#   export AZDO_ORG_SERVICE_URL="https://dev.azure.com/324DSTraining"
#   export AZDO_PERSONAL_ACCESS_TOKEN="<PAT with Variable Groups (read, create, & manage) scope>"

azdo_project_name = "training-proj"

# New Key Vault this stack will create - must be globally unique, 3-24 alphanumeric/hyphen chars.
key_vault_name = "<key-vault-name>"

# Entra ID object ID of the AzureTraining service connection's service principal - find via:
#   az ad sp show --id <appId> --query id -o tsv
# (appId is on the service connection's "Manage Service Principal" link in Azure DevOps)
azure_training_sp_object_id = "<object-id>"

# GitHub PAT (repo scope, or fine-grained Contents:read on Olalekog/azure-app-deploy) - used to
# create the GitHub service connection Azure DevOps needs to read this repo. Not published to
# Library anywhere, only this stack uses it.
github_personal_access_token = "<github-pat>"

# Your own Entra ID object ID - approves the todoapp-production / todoapp-devops gates. Find via:
#   az ad signed-in-user show --query id -o tsv
approver_object_id = "<your-object-id>"

# Published to todoapp-staging-tfvars / todoapp-production-tfvars so infra-deploy.yml can
# reconstruct infra/terraform/terraform.tfvars - keep these in sync with
# infra/terraform/terraform.tfvars.staging.example / .production.example by hand, there's no
# automatic link between the two stacks for these values.
staging_tfvars = {
  existing_vnet_name      = "VM-VNET"
  frontend_subnet_prefix  = "10.0.1.0/24"
  backend_subnet_prefix   = "10.0.2.0/24"
  backend_lb_private_ip   = "10.0.2.4"
  admin_username          = "azureuser"
  admin_ssh_public_key    = "ssh-ed25519 AAAA... your-public-key"
  frontend_instance_count = 1
  frontend_instance_max   = 2
  backend_instance_count  = 1
  backend_instance_max    = 2
}

production_tfvars = {
  existing_vnet_name      = "VM-VNET"
  frontend_subnet_prefix  = "10.0.3.0/24"
  backend_subnet_prefix   = "10.0.4.0/24"
  backend_lb_private_ip   = "10.0.4.4"
  admin_username          = "azureuser"
  admin_ssh_public_key    = "ssh-ed25519 AAAA... your-public-key"
  frontend_instance_count = 2
  frontend_instance_max   = 6
  backend_instance_count  = 2
  backend_instance_max    = 6
}
